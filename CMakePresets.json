{
  "version": 5,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "linux-dev",
      "displayName": "Arch Linux / Ninja / Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-dev",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON", "ECOS_GLFW_VERSION": "3.5.1"},
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}
    },
    {
      "name": "windows-dev",
      "displayName": "Windows MSVC / Ninja / Debug (NO VALIDADO)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-dev",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON", "ECOS_GLFW_VERSION": "3.4"},
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}
    }
  ],
  "buildPresets": [
    {"name": "linux-dev", "configurePreset": "linux-dev"},
    {"name": "windows-dev", "configurePreset": "windows-dev"}
  ],
  "testPresets": [
    {"name": "linux-dev", "configurePreset": "linux-dev", "output": {"outputOnFailure": true}},
    {"name": "windows-dev", "configurePreset": "windows-dev", "output": {"outputOnFailure": true}}
  ]
}
